{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "status",
  "compatibility_date": "2026-10-28",
  // No Worker code: Cloudflare serves the built dist/ as static assets, which don't count as Worker requests.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "status.aroncreates.com", "custom_domain": true }]
}
